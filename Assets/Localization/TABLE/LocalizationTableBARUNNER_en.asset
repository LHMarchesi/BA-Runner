%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LocalizationTableBARUNNER_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 48cb04d4449e7184fa0f759f675441c6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1053257192718336
    m_Localized: 'ENZO: RAQUEL, I''M READY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257297575936
    m_Localized: '*BIP*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257297575937
    m_Localized: '*RAQUEL: MEET HIM AT THE OBELISCO*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770240
    m_Localized: 'ENZO: IT''S JUST ONE MORE NIGHT...  ONE MORE NIGHT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770241
    m_Localized: 'VINCENT: ENZO? THE TAXI DRIVER?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770242
    m_Localized: "VINCENT: LET'S GO TO CONSTITUCI\xD3N."
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770243
    m_Localized: 'VINCENT: I NEED TO BE THERE IN 15 MINUTES.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770244
    m_Localized: 'VINCENT: CAN YOU?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770245
    m_Localized: 'VINCENT: THIS CITY... IT''S GORGEOUS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770246
    m_Localized: 'VINCENT: IT NEVER SLEEPS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770247
    m_Localized: 'VINCENT: SEVEN MILLION PEOPLE WALK DAILY HERE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770248
    m_Localized: 'VINCENT: ONCE, I HEARD A STORY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770249
    m_Localized: 'VINCENT: AN OLD MAN TAKES THE SUBWAY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770250
    m_Localized: 'VINCENT: SUDDENLY, HIS HEART STOPS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770251
    m_Localized: 'VINCENT: HE SEEMS TO BE ASLEEP.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770252
    m_Localized: 'VINCENT: NO ONE NOTICE HIM FOR HOURS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770253
    m_Localized: 'VINCENT: THE WORLD FORGOT HIS EXISTANCE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770254
    m_Localized: 'VINCENT: ONLY TAKES THEM 15 MINUTES TO LINE C TERMINAL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770255
    m_Localized: 'VINCENT: DO YOU THINK THEY WILL SEE HIM?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770256
    m_Localized: 'VINCENT: HAHAHA, BYE ENZO!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770257
    m_Localized: 'ENZO: WOULD THEY SEE HIM?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770258
    m_Localized: '???: SORRY, IT''S UNTENABLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770259
    m_Localized: 'RAQUEL: ENZO...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770260
    m_Localized: '*BIP*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770261
    m_Localized: 'ENZO: ANOTHER RIDE?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770262
    m_Localized: 'RAQUEL: ENZO, IT''S OVER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770263
    m_Localized: 'RAQUEL: WE''RE CLOSING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770264
    m_Localized: 'RAQUEL: YOU MUST GET ANOTHER CAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770265
    m_Localized: 'RAQUEL: IF YOU WANT TO KEEP WORKING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770266
    m_Localized: 'ENZO: I UNDERSTAND.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770267
    m_Localized: 'RAQUEL: ENZO...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770268
    m_Localized: 'RAQUEL: TAKE CARE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770269
    m_Localized: 'GERARDO: YOUR EYE, YOU MUST GO TO THE DOCTOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770270
    m_Localized: 'GERARDO: HOW DID YOU GET INJURED?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770271
    m_Localized: 'RULO: NOTHING, I HAD A FIGHT WITH A GOOBER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770272
    m_Localized: 'GERARDO: YOU GOTTA GROW UP, HUH...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770273
    m_Localized: 'RULO: ANYWAYS, HE MADE ME MAD.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770274
    m_Localized: 'ENZO: HELLO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770275
    m_Localized: 'GERARDO: WHY ARE YOU HERE? THE CAR''S JUST FINE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770276
    m_Localized: 'ENZO: MY RUTINE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770277
    m_Localized: 'GERARDO: DO YOU CONTINUE TODAY? HOW''S THAT GIRL?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770278
    m_Localized: 'ENZO: WE CLOSED.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770279
    m_Localized: 'ENZO: I''VE TO FIND ANOTHER JOB.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770280
    m_Localized: 'GERARDO: LISTEN... IT''S A NICE CAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770281
    m_Localized: 'GERARDO: I KNOW A FELLA THAT''LL PAY TOP DOLLAR FOR IT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770282
    m_Localized: 'ENZO: IT''S NOT FOR SALE GERARDO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770283
    m_Localized: 'GERARDO: THINK OF IT. IF YOU NEED IT, IT''S THERE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770284
    m_Localized: 'ENZO: WHY YOU HAVE MY NUMBER?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770285
    m_Localized: 'VINCENT: RAQUEL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770286
    m_Localized: 'VINCENT: ENZO, YOU STILL KEEP THE CAR?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770287
    m_Localized: YES.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770288
    m_Localized: NOT FOR MUCH LONGER.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770289
    m_Localized: 'ENZO: YES.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770290
    m_Localized: 'VINCENT: YOU DROVE SO WELL THE OTHER DAY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770291
    m_Localized: 'VINCENT: CAN YOU DO IT AGAIN?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770292
    m_Localized: 'ENZO: WHERE? HOW MUCH?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770293
    m_Localized: 'VINCENT: 14:00 PM, CABOTO, 1400. NEAR THAT BRIDGE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770294
    m_Localized: 'VINCENT: YOUR PAYMENT? I''LL TRIPLE IT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770295
    m_Localized: 'VINCENT: YOUR CLIENT IS OMAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770296
    m_Localized: 'VINCENT: HE''S OLD, BALD AND CAPRICIOUS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770297
    m_Localized: 'VINCENT: BE THERE ON TIME. I''M SICK OF HIM.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770298
    m_Localized: 'VINCENT:: HE''LL MENTION THE TAP.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770299
    m_Localized: 'OMAR: EVA 026.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770300
    m_Localized: 'OMAR: WE GO TO CARBONILLA, IN PATERNAL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770301
    m_Localized: 'OMAR: ONE DAY, THIS SHIT IS GONNA KILL ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770302
    m_Localized: 'OMAR: HOW DO YOU END UP HERE?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770303
    m_Localized: 'ENZO: I KNOW VINCENT. HE TOLD ME TO TAKE THIS RIDE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770304
    m_Localized: 'OMAN: I BET IS FOR YOUR CAR. ALSO, YOU ARE SO RESERVED.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770305
    m_Localized: 'OMAN: THAT''S GOOD FOR THE BUSINESS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770306
    m_Localized: 'OMAN: SAY MY NAME IF THEY CAUSE TROUBLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770307
    m_Localized: 'OMAN: I''M SO TIRED...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770308
    m_Localized: 'OMAN: WE''VE TO HOLD UP, THAT''S WHAT WE GET.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770309
    m_Localized: 'OMAN: ENZO, WHY YOU DO THIS?'
    m_Metadata:
      m_Items: []
  - m_Id: 12477082431489
    m_Localized: 'ENZO: THIS IS EVERYTHING I KNOW.'
    m_Metadata:
      m_Items: []
  - m_Id: 12477082431490
    m_Localized: 'ENZO: I''VE NEVER GIVEN IT MUCH THOUGHT.'
    m_Metadata:
      m_Items: []
  - m_Id: 12477086625793
    m_Localized: 'ENZO: THIS IS EVERYTHING I KNOW.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770310
    m_Localized: 'OMAN: I UNDERSTAND... SEE YOU, KID.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770311
    m_Localized: 'ENZO: ANOTHER RIDE?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770312
    m_Localized: 'VINCENT: TO BARRIO CHINO, AT 18:00 PM.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770313
    m_Localized: 'VINCENT: THIS RIDE IS SPECIAL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770314
    m_Localized: 'VINCENT: SHE''S ELENA.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770315
    m_Localized: 'VINCENT: SHE''LL WAIT FOR YOU AT THE ENTRANCE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770316
    m_Localized: 'VINCENT: ENZO... ONE MORE THING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770317
    m_Localized: 'VINCENT: DON''T BE FOOLED BY HER CHARMS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770318
    m_Localized: 'VINCENT: SHE''S A WITCH.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770319
    m_Localized: 'ELENA: FINALLY, A PRETTY CAR. GO TO THE HOTEL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770321
    m_Localized: 'ELENA: THE ONLY MAJOR HOTEL OF RETIRO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1426986460528640
    m_Localized: '???: THANK YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770320
    m_Localized: 'ENZO: WHICH HOTEL?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770322
    m_Localized: 'ELENA: SO MANY LIGHTS!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770323
    m_Localized: 'ELENA: ENZO, IN THIS WORLD, ONLY MONEY COUNTS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770324
    m_Localized: 'ELENA: VINCENT KNOWS THAT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770325
    m_Localized: 'ELENA: NOTHING MATTERS MORE THAN MONEY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770326
    m_Localized: '???: LIU, THE BOSS WANTS US TO START WITHOUT HER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770327
    m_Localized: 'ELENA: AS YOU SAY...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770328
    m_Localized: 'ELENA: "IT''S ALL ABOUT THE BENJAMINS".'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770329
    m_Localized: 'ELENA: LEAVE ME IN THE PARKING LOT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770330
    m_Localized: '???: I''M FED UP. ASSHOLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770331
    m_Localized: '???: THE GUY FROM THE OTHER DAY. HE CAME AGAIN.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770332
    m_Localized: 'ELENA: AND YOU, ENZO?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770333
    m_Localized: 'ELENA: DO YOU DANCE FOR MONEY?'
    m_Metadata:
      m_Items: []
  - m_Id: 12477086625794
    m_Localized: '*AVOID SPEAKING*'
    m_Metadata:
      m_Items: []
  - m_Id: 12477086625795
    m_Localized: 'ENZO: MONEY ISN''T EVERYTHING FOR ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770334
    m_Localized: 'ELENA: GREETINGS TO VINCENT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770335
    m_Localized: 'ENZO: HELLO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770336
    m_Localized: 'VINCENT: I''M NOT HAPPY WITH THIS RIDE, BUT THE PAYMENT IS GOOD.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770337
    m_Localized: 'VINCENT: DON''T TALK TO HIM AND TAKE HIM QUICKLY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770338
    m_Localized: 'VINCENT: PLAZA ITALIA, IN FRONT OF LA RURAL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770339
    m_Localized: 'VINCENT: HE''S TIAGO AND IS WAITING YOU, BUT HE''S IN A HURRY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770340
    m_Localized: 'TIAGO: I''M GLAD YOU''RE HERE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770341
    m_Localized: 'TIAGO: COME ON, LET''S GET OUT OF HERE!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770342
    m_Localized: 'ENZO: MONEY ISN''T EVERYTHING FOR ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770343
    m_Localized: 'ELENA: YOU ALWAYS SAY THAT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770344
    m_Localized: 'ELENA: GREETINGS TO VINCENT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770345
    m_Localized: 'ENZO: HOLA.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770346
    m_Localized: 'VINCENT: OMAN WANTS YOU. HE PAYS VERY WELL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770347
    m_Localized: 'VINCENT: DON''T ASK QUESTIONS AND, IF POSSIBLE, DON''T TALK.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770348
    m_Localized: 'VINCENT: AMANCIO ALCORTA AND LUNA STREET. AT THE CORNER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770349
    m_Localized: 'VINCENT: THEY ARE WAITING FOR YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770350
    m_Localized: 'MIGUEL: THERE HE IS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770351
    m_Localized: 'MIGUEL: OMAR! HE IS HERE!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770352
    m_Localized: 'OMAR: I''LL SITTING UP FRONT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770353
    m_Localized: 'OMAR: YOU TAKE HIM AWAY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770354
    m_Localized: 'MIGUEL: HELLO, ENZO! OMAR IS COMING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770355
    m_Localized: 'MIGUEL: AND MY FRIEND IS DRUNK. WE''LL TAKE HIM.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770356
    m_Localized: 'MIGUEL: IS THERE ANY PROBLEM?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770357
    m_Localized: 'ENZO: COME IN.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770358
    m_Localized: 'OMAR: GO. IT''S OUTSIDE THE CITY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770359
    m_Localized: 'OMAR: JOSE LEON SUARES. IN FRONT OF THE LANDFILL.'
    m_Metadata:
      m_Items: []
  - m_Id: 12477086625792
    m_Localized: 'ENZO: I''VE NEVER GIVEN IT MUCH THOUGHT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770360
    m_Localized: 'OMAR: THAT''S DANGEROUS. SEE YOU, KID.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770361
    m_Localized: 'ENZO: THANK YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770362
    m_Localized: 'VINCENT: I HAVE ANOTHER RIDE, ENZO. FOR NOW.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770363
    m_Localized: 'ENZO: WHERE?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770364
    m_Localized: "VINCENT: JUEZ TED\xCDN 2845, PALERMO CHICO."
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770365
    m_Localized: 'VINCENT: THIS RIDE IS IMPORTANT, ENZO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770366
    m_Localized: 'ENZO: UNDERSTOOD.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770367
    m_Localized: 'MARCOS: MUMMY, HE''S HERE!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770368
    m_Localized: 'CECILIA: BE CAREFUL HONEY. WEAR YOUR SEATBELT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770369
    m_Localized: 'CECILIA: WE GO TO LA RURAL, ENZO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770370
    m_Localized: 'CECILIA: WE''RE LATE. THANKS FOR COMING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770371
    m_Localized: 'MARCOS: DO YOU LIKE MY CAR, ENZO?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770372
    m_Localized: '*AVOID SPEAKING*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770373
    m_Localized: 'ENZO: IT''S A GREAT CAR. MY FRIEND HAD ONE LIKE THAT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770374
    m_Localized: 'CECILIA: WE''LL TALK NEXT TIME. COME ON, IT''S LATE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770375
    m_Localized: 'CECILIA AND ENZO: BYE ENZO! THANK YOU!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770376
    m_Localized: 'ENZO: HOLA.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770377
    m_Localized: 'VINCENT: I''M NOT HAPPY WITH THIS RIDE, BUT THE PAYMENT IS GOOD.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770378
    m_Localized: 'VINCENT: DON''T TALK TO HIM AND TAKE HIM QUICKLY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770379
    m_Localized: 'VINCENT: PLAZA ITALIA, IN FRONT OF LA RURAL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770380
    m_Localized: 'VINCENT: HE''S TIAGO AND IS WAITING YOU, BUT HE''S IN A HURRY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770381
    m_Localized: 'THIAGO: I''M GLAD YOU''RE HERE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770382
    m_Localized: 'TIAGO: COME ON, LET''S GET OUT OF HERE!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770383
    m_Localized: 'ENZO: IT''S A GREAT CAR. MY FRIEND HAD ONE LIKE THAT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770384
    m_Localized: 'MARCOS: REALLY?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770385
    m_Localized: 'ENZO: YES, I HAVEN''T SEE HIM IN A WHILE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770386
    m_Localized: 'MARCOS: AND WHY DON''T YOU VISIT HIM?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770387
    m_Localized: 'CECILIA: WE''LL TALK NEXT TIME. COME ON, IT''S LATE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770388
    m_Localized: 'CECILIA AND ENZO: BYE ENZO! THANK YOU!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770389
    m_Localized: 'ENZO: HOLA.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770390
    m_Localized: 'VINCENT: OMAR WANTS YOU. HE PAYS VERY WELL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770391
    m_Localized: 'VINCENT: DON''T ASK QUESTIONS AND, IF POSSIBLE, DON''T TALK.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770392
    m_Localized: 'VINCENT: AMANCIO ALCORTA AND LUNA STREET. AT THE CORNER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770393
    m_Localized: 'VINCENT: THEY ARE WAITING FOR YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770394
    m_Localized: 'MIGUEL: THERE HE IS.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770395
    m_Localized: 'MIGUEL: OMAR! HE''S HERE!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770396
    m_Localized: 'OMAR: I''LL SITTING UP FRONT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770397
    m_Localized: 'OMAR: YOU TAKE HIM AWAY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770398
    m_Localized: 'MIGUEL: HELLO, ENZO! OMAR IS COMING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770399
    m_Localized: 'MIGUEL: AND MY FRIEND IS DRUNK. WE''LL TAKE HIM.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770400
    m_Localized: 'MIGUEL: IS THERE ANY PROBLEM?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770401
    m_Localized: 'ENZO: COME IN.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770402
    m_Localized: 'OMAR: GO. IT''S OUTSIDE THE CITY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770403
    m_Localized: 'OMAR: JOSE LEON SUARES. IN FRONT OF THE LANDFILL.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770404
    m_Localized: "TIAGO: I NEED TO GO TO COSTANERA IN VICENTE L\xD3PEZ."
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770405
    m_Localized: 'TIAGO: I GET OUT NEAR THE BELGRANO''S MONUMENT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770406
    m_Localized: 'TIAGO: THERE WAS A CAR EXHIBITION, A LOT OF DISTRACTED PEOPLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770407
    m_Localized: 'TIAGO: I MEET MANY CRAZY PEOPLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770408
    m_Localized: 'TIAGO: AND THIS KIDS WERE ANNOYING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770409
    m_Localized: 'TIAGO: AND WEEPING. JUST SHUT UP AND OBEY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770410
    m_Localized: 'TIAGO: ANYWAYS, LET''S GO TO THE GOOD PART, MONEY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770411
    m_Localized: 'TIAGO: I MADE A MISTAKE AND I KEPT THIS SHIT TOO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770412
    m_Localized: 'TIAGO: IT WAS IN THE BAG, THAT''S WHY HE WAS CRYING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770413
    m_Localized: 'TIAGO: I RUNNED AS SOON AS THE GUY START SHOUTING.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770414
    m_Localized: 'TIAGO: THAT''S HOW THE JOB IS SOMETIMES. HERE, THIS IS FOR YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770415
    m_Localized: 'TIAGO: GREETINGS TO VINCENT. HE SAVED ME THIS TIME.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770416
    m_Localized: "ENZO: \xA1\xA1\xA1FUCKKKKKKK!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770417
    m_Localized: "ENZO: \xA1\xA1\xA1FUCKKKK!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770418
    m_Localized: '*...*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770419
    m_Localized: '*...*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770420
    m_Localized: 'ENZO: WHAT AM I GOING TO DO?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770421
    m_Localized: SELL THE CAR.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770422
    m_Localized: LEAVE THE TOWN.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770423
    m_Localized: STAY.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770424
    m_Localized: 'MIGUEL: I THINK WE ARRIVE EARLY TO THE PARTY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770425
    m_Localized: 'OMAR: MIGUEL, GO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770426
    m_Localized: 'OMAR: I''LL STAY HERE FOR A MOMENT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770427
    m_Localized: 'TIAGO: WHE... WHERE...? WHERE AM I?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770428
    m_Localized: 'OMAR: I ALWAYS CHOOSE VINCENT.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770429
    m_Localized: 'OMAR: '
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770430
    m_Localized: 'OMAR: DID I SAY SOMETHING?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770431
    m_Localized: 'ENZO: NO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770432
    m_Localized: 'OMAR: DID YOU SEE SOMETHING?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770433
    m_Localized: 'ENZO: NO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770434
    m_Localized: 'OMAR: DID YOU DO SOMETHING?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770435
    m_Localized: 'ENZO: NO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770436
    m_Localized: 'OMAR: IT''S TOO LATE FOR ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770437
    m_Localized: 'OMAR: WHAT ABOUT YOU? '
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770438
    m_Localized: "ENZO: \xA1\xA1\xA1FUCKKKKKKK!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770439
    m_Localized: "ENZO: \xA1\xA1\xA1FUCKKKK!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770440
    m_Localized: '*...*'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770441
    m_Localized: "\xA8*...*"
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770442
    m_Localized: 'ENZO: WHAT AM I GOING TO DO?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770443
    m_Localized: SELL THE CAR.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770444
    m_Localized: LEAVE THE CITY.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770445
    m_Localized: STAY.
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770446
    m_Localized: 'VINCENT: HELLO, GERAR. I''M RUNNING LATE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770447
    m_Localized: 'VINCENT: WHAT DO YOU HAVE FOR ME?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770448
    m_Localized: 'GERARDO: A 502 IN GREAT CONDITION. A GUY LET HIM GO.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770449
    m_Localized: 'VINCENT: WHAT WAS HIS NAME?'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770450
    m_Localized: 'GERARDO: MMM... SOMETHING WITH AN E...'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770451
    m_Localized: 'GERARDO: ERNESTO... EZEQUIEL? I DON''T REMEMBER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770452
    m_Localized: 'VINCENT: DOESN''T MATTER.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770453
    m_Localized: 'VINCENT: SAME HOTEL. AT 4 PM.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770454
    m_Localized: 'RAQUEL: HELLO!'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770455
    m_Localized: 'RAQUEL: SO THIS IS WHERE I FIND YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770456
    m_Localized: 'RAQUEL: HAHA, I SAW THE SAME BOOKLET.'
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770457
    m_Localized: 'ENZO: ANOTHER RIDE? '
    m_Metadata:
      m_Items: []
  - m_Id: 1053257301770458
    m_Localized: 'VINCENT: AEROPARQUE, IN 15 MINUTES.'
    m_Metadata:
      m_Items: []
  - m_Id: 1426986540220416
    m_Localized: FULL SCREEN
    m_Metadata:
      m_Items: []
  - m_Id: 1426986540220417
